# Telegram Media Bot - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# BOT CONFIGURATION (Required)
# =============================================================================
# Get from @BotFather
BOT_TOKEN=your_bot_token_here

# Comma-separated list of admin user IDs (Telegram numeric IDs)
BOT_ADMIN_IDS=123456789,987654321

# Local Telegram Bot API Server (optional, for >50MB uploads)
# See docker-compose.yml for the telegram-bot-api service
BOT_LOCAL_API_URL=http://telegram-bot-api:8081
BOT_LOCAL_API_FILE_URL=http://telegram-bot-api:8081

# Webhook mode (optional, for production)
# BOT_WEBHOOK_URL=https://your-domain.com
# BOT_WEBHOOK_PATH=/webhook
# BOT_WEBHOOK_PORT=8080

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQLite (default, file-based)
DB_URL=sqlite+aiosqlite:///data/bot.db

# PostgreSQL (for production)
# DB_URL=postgresql+asyncpg://user:password@localhost:5432/botdb

# Echo SQL queries (debug)
DB_ECHO=false

# =============================================================================
# DOWNLOAD CONFIGURATION
# =============================================================================
DOWNLOAD_TEMP_DIR=/app/data/temp
DOWNLOAD_CACHE_DIR=/app/data/cache
DOWNLOAD_DOWNLOADS_DIR=/app/data/downloads

# Maximum file size in bytes (2GB for local Bot API server)
DOWNLOAD_MAX_FILE_SIZE=2000000000

# Concurrency limits
DOWNLOAD_MAX_CONCURRENT_DOWNLOADS=3
DOWNLOAD_MAX_CONCURRENT_PER_USER=2
DOWNLOAD_MAX_CONCURRENT_FFMPEG=2

# Default quality/format settings
DOWNLOAD_DEFAULT_VIDEO_QUALITY=720p
DOWNLOAD_DEFAULT_AUDIO_FORMAT=mp3
DOWNLOAD_DEFAULT_AUDIO_BITRATE=320k

# yt-dlp cookies file (for age-restricted/private content)
# DOWNLOAD_YTDLP_COOKIES_FILE=/app/data/cookies.txt

# Spotify API credentials (for spotdl)
# DOWNLOAD_SPOTDL_CLIENT_ID=your_spotify_client_id
# DOWNLOAD_SPOTDL_CLIENT_SECRET=your_spotify_client_secret

# Yandex Music token
# DOWNLOAD_YANDEX_MUSIC_TOKEN=your_yandex_token

# Genius API token (for lyrics)
# DOWNLOAD_GENIUS_TOKEN=your_genius_token

# =============================================================================
# QUEUE CONFIGURATION
# =============================================================================
QUEUE_MAX_QUEUE_SIZE=100
QUEUE_TASK_TIMEOUT=3600
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_BASE_DELAY=2.0
QUEUE_RETRY_MAX_DELAY=60.0

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=3600
CACHE_MAX_SIZE=1000

# =============================================================================
# RATE LIMITING
# =============================================================================
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT_LIMIT=30
RATELIMIT_DOWNLOAD_LIMIT=10
RATELIMIT_SEARCH_LIMIT=20

# =============================================================================
# LOCALIZATION
# =============================================================================
I18N_DEFAULT_LANGUAGE=ru

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_STRUCTURED=true

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=production
DEBUG=false

# =============================================================================
# TELEGRAM BOT API SERVER (for local API server)
# =============================================================================
# Get from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash